# Public demo configuration
APP_ENV=demo
DEMO_MODE=true
DEFAULT_LANGUAGE=tr

# Optional LLM providers.
# Keep blank for deterministic demo mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Live extraction is intentionally disabled for the public demo.
GSC_ENABLED=false
GA4_ENABLED=false
POSTGRES_ENABLED=false
